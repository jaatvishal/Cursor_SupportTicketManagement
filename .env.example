# SQL Server Express (Windows Authentication)
# Used by .NET API in appsettings.Development.json
DefaultConnection=Data Source=localhost\SQLEXPRESS;Initial Catalog=SupportTicketDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=0

# Frontend URL (for CORS)
FrontendUrl=http://localhost:4200

# API URL (for reference)
ApiUrl=http://localhost:5000
